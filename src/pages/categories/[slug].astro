---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchFilter from '../../components/SearchFilter.astro';
import TutorialList from '../../components/TutorialList.astro';
import {
  categories,
  languages as allLanguages,
  getTutorialsByCategory,
  getCategoryBySlug,
} from '../../utils/helpers';
import { collectionPageSchema, breadcrumbSchema } from '../../utils/seo';
import { canonicalUrl } from '../../utils/site';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { slug: cat.slug } }));
}

const { slug } = Astro.params;
const category = getCategoryBySlug(slug!);
if (!category) return Astro.redirect('/categories');

const categoryTutorials = getTutorialsByCategory(slug!);

// Derive available languages for this category
const langNames = [...new Set(categoryTutorials.flatMap((t) => t.languages))];
const categoryLangs = langNames
  .map((name) => {
    const found = allLanguages.find((l) => l.name === name);
    return found ? { name: found.name, slug: found.slug } : null;
  })
  .filter((l): l is { name: string; slug: string } => l !== null)
  .sort((a, b) => a.name.localeCompare(b.name));

const schemas = [
  collectionPageSchema({
    name: `Build Your Own ${category.name}`,
    description: category.description,
    pathname: `/categories/${slug}`,
    items: categoryTutorials.map((t) => ({ name: t.title, url: t.url })),
  }),
  breadcrumbSchema([
    { name: 'Categories', pathname: '/categories' },
    { name: category.name },
  ]),
];
---

<BaseLayout
  title={`Build Your Own ${category.name}`}
  description={`${category.description} Browse ${categoryTutorials.length} step-by-step tutorials across ${categoryLangs.length} programming languages.`}
  canonicalPath={`/categories/${slug}`}
  schemas={schemas}
>
  <div class="container-page py-8 sm:py-12">
    <Breadcrumbs
      items={[
        { label: 'Categories', href: '/categories' },
        { label: category.name },
      ]}
    />

    <div class="mb-6">
      <div class="flex items-start gap-3">
        <span class="shrink-0 text-2xl sm:text-3xl" aria-hidden="true">{category.icon}</span>
        <div class="min-w-0">
          <h1 class="heading-1 !text-2xl sm:!text-3xl lg:!text-4xl">Build Your Own {category.name}</h1>
          <p class="mt-1 text-sm text-body">{category.description}</p>
        </div>
      </div>
      <p class="mt-3 text-xs text-caption">
        {categoryTutorials.length} {categoryTutorials.length === 1 ? 'tutorial' : 'tutorials'} · {categoryLangs.length} {categoryLangs.length === 1 ? 'language' : 'languages'}
      </p>
    </div>

    <SearchFilter
      placeholder={`Search ${category.name.toLowerCase()} tutorials...`}
      languages={categoryLangs}
      showLanguageFilter={categoryLangs.length > 2}
    />

    <TutorialList tutorials={categoryTutorials} />
  </div>
</BaseLayout>
