---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import { categories, tutorials } from '../../utils/helpers';
import { collectionPageSchema, breadcrumbSchema } from '../../utils/seo';
import { canonicalUrl } from '../../utils/site';

const schemas = [
  collectionPageSchema({
    name: 'All Categories — Build Your Own Tutorials',
    description: `Browse ${categories.length} categories of build-your-own tutorials.`,
    pathname: '/categories',
    items: categories.map((c) => ({
      name: c.name,
      url: canonicalUrl(`/categories/${c.slug}`),
    })),
  }),
  breadcrumbSchema([{ name: 'Categories' }]),
];
---

<BaseLayout
  title="All Categories"
  description={`Browse ${categories.length} categories of build-your-own tutorials across ${tutorials.length}+ guides. Find step-by-step tutorials for databases, compilers, games, operating systems, and more.`}
  canonicalPath="/categories"
  schemas={schemas}
>
  <div class="container-page py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'Categories' }]} />

    <div class="mb-6">
      <h1 class="heading-1">All Categories</h1>
      <p class="mt-2 text-sm text-body sm:text-base">
        {categories.length} categories with {tutorials.length}+ tutorials to explore
      </p>
    </div>

    <div class="grid gap-3 grid-cols-1 xs:grid-cols-2 lg:grid-cols-3">
      {categories.map((cat) => (
        <CategoryCard category={cat} size="large" />
      ))}
    </div>
  </div>
</BaseLayout>
