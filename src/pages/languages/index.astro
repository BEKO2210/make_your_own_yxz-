---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LanguageBadge from '../../components/LanguageBadge.astro';
import { languages, tutorials } from '../../utils/helpers';
import { collectionPageSchema, breadcrumbSchema } from '../../utils/seo';
import { canonicalUrl } from '../../utils/site';

const schemas = [
  collectionPageSchema({
    name: 'Tutorials by Programming Language',
    description: `Browse tutorials in ${languages.length} programming languages.`,
    pathname: '/languages',
    items: languages.map((l) => ({
      name: l.name,
      url: canonicalUrl(`/languages/${l.slug}`),
    })),
  }),
  breadcrumbSchema([{ name: 'Languages' }]),
];
---

<BaseLayout
  title="Browse by Language"
  description={`Explore ${tutorials.length}+ build-your-own tutorials across ${languages.length} programming languages including Python, JavaScript, C, Rust, Go, and more.`}
  canonicalPath="/languages"
  schemas={schemas}
>
  <div class="container-page py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'Languages' }]} />

    <div class="mb-6">
      <h1 class="heading-1">Browse by Language</h1>
      <p class="mt-2 text-sm text-body sm:text-base">
        {languages.length} programming languages with {tutorials.length}+ tutorials
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      {languages.map((lang) => (
        <LanguageBadge language={lang} />
      ))}
    </div>
  </div>
</BaseLayout>
