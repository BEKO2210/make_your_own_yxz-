---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SearchFilter from '../../components/SearchFilter.astro';
import TutorialList from '../../components/TutorialList.astro';
import { languages, categories, getTutorialsByLanguage, getLanguageBySlug } from '../../utils/helpers';

export function getStaticPaths() {
  return languages.map((lang) => ({
    params: { slug: lang.slug },
  }));
}

const { slug } = Astro.params;
const language = getLanguageBySlug(slug!);

if (!language) {
  return Astro.redirect('/languages');
}

const langTutorials = getTutorialsByLanguage(slug!);

// Get categories available for this language
const langCategories = [...new Set(langTutorials.map((t) => t.categorySlug))]
  .map((catSlug) => {
    const cat = categories.find((c) => c.slug === catSlug);
    return cat ? { slug: cat.slug, name: cat.name } : null;
  })
  .filter(Boolean)
  .sort((a, b) => a!.name.localeCompare(b!.name)) as { slug: string; name: string }[];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${language.name} Build-Your-Own Tutorials`,
  description: `${langTutorials.length} step-by-step tutorials for building projects from scratch in ${language.name}.`,
  url: `https://makeyourownxyz.com/languages/${slug}`,
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://makeyourownxyz.com' },
      { '@type': 'ListItem', position: 2, name: 'Languages', item: 'https://makeyourownxyz.com/languages' },
      { '@type': 'ListItem', position: 3, name: language.name },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: langTutorials.length,
    itemListElement: langTutorials.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t.title,
      url: t.url,
    })),
  },
};
---

<BaseLayout
  title={`${language.name} Tutorials`}
  description={`Explore ${langTutorials.length} step-by-step tutorials for building projects from scratch in ${language.name}. Build databases, compilers, games, and more.`}
  schema={schema}
>
  <div class="container-page py-10 sm:py-14">
    <Breadcrumbs
      items={[
        { label: 'Languages', href: '/languages' },
        { label: language.name },
      ]}
    />

    <div class="mb-8">
      <h1 class="prose-heading text-3xl sm:text-4xl">{language.name} Tutorials</h1>
      <p class="mt-2 text-slate-500">
        {langTutorials.length} tutorials across {langCategories.length} categories
      </p>
    </div>

    <SearchFilter
      placeholder={`Search ${language.name} tutorials...`}
      categories={langCategories}
      showCategoryFilter={langCategories.length > 2}
    />

    <TutorialList tutorials={langTutorials} showCategory={true} />
  </div>
</BaseLayout>
