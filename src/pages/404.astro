---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div class="container-page flex flex-col items-center justify-center py-20 text-center">
    <p class="text-5xl font-bold sm:text-6xl" style="color: rgb(var(--color-border));">404</p>
    <h1 class="mt-4 text-xl font-semibold sm:text-2xl" style="color: rgb(var(--color-text));">Page Not Found</h1>
    <p class="mt-2 text-sm text-body">The page you're looking for doesn't exist or has been moved.</p>
    <div class="mt-6 flex flex-col gap-3 xs:flex-row">
      <a href="/" class="btn-primary">Go Home</a>
      <a href="/categories" class="btn-secondary">Browse Categories</a>
    </div>
  </div>
</BaseLayout>
