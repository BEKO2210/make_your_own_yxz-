---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../utils/site';
import { breadcrumbSchema } from '../utils/seo';
import { tutorials, categories, languages } from '../utils/helpers';

const schemas = [breadcrumbSchema([{ name: 'About' }])];
---

<BaseLayout
  title="About"
  description="Learn about Make Your Own XYZ — a curated directory of build-your-own tutorials sourced from the open-source community."
  canonicalPath="/about"
  schemas={schemas}
>
  <div class="container-page py-8 sm:py-12">
    <Breadcrumbs items={[{ label: 'About' }]} />

    <article class="mx-auto max-w-2xl">
      <h1 class="heading-1 !text-2xl sm:!text-3xl">About This Project</h1>

      <div class="mt-6 space-y-5 text-sm text-body leading-relaxed sm:text-base">
        <p>
          <strong style="color: rgb(var(--color-text));">{SITE.name}</strong> is a web interface for the popular open-source repository
          <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="underline" style="color: rgb(var(--color-accent));">codecrafters-io/build-your-own-x</a>,
          which curates step-by-step tutorials for rebuilding real technologies from scratch.
        </p>

        <p>
          The goal is simple: make these {tutorials.length}+ tutorials easier to discover, browse, and filter. Instead of scrolling through a long README, you can search by category, programming language, or keyword.
        </p>

        <div class="card p-5">
          <h2 class="text-sm font-semibold" style="color: rgb(var(--color-text));">By the Numbers</h2>
          <dl class="mt-3 grid grid-cols-3 gap-4 text-center">
            <div>
              <dt class="text-xs text-caption">Tutorials</dt>
              <dd class="text-xl font-bold sm:text-2xl" style="color: rgb(var(--color-text));">{tutorials.length}+</dd>
            </div>
            <div>
              <dt class="text-xs text-caption">Categories</dt>
              <dd class="text-xl font-bold sm:text-2xl" style="color: rgb(var(--color-text));">{categories.length}</dd>
            </div>
            <div>
              <dt class="text-xs text-caption">Languages</dt>
              <dd class="text-xl font-bold sm:text-2xl" style="color: rgb(var(--color-text));">{languages.length}</dd>
            </div>
          </dl>
        </div>

        <h2 class="!mt-8 text-base font-semibold sm:text-lg" style="color: rgb(var(--color-text));">Philosophy</h2>
        <p>
          Building things from scratch is one of the most effective ways to learn. When you implement a database, a compiler, or an operating system yourself, you gain insights that no amount of documentation reading can provide.
        </p>
        <blockquote class="border-l-2 pl-4 italic text-caption" style="border-color: rgb(var(--color-accent) / 0.4);">
          "What I cannot create, I do not understand." — Richard Feynman
        </blockquote>

        <h2 class="!mt-8 text-base font-semibold sm:text-lg" style="color: rgb(var(--color-text));">Attribution</h2>
        <p>
          The original <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="underline" style="color: rgb(var(--color-accent));">build-your-own-x</a> repository was created by
          <a href="https://github.com/danistefanovic" target="_blank" rel="noopener noreferrer" class="underline" style="color: rgb(var(--color-accent));">Daniel Stefanovic</a>
          and is now maintained by <a href="https://codecrafters.io" target="_blank" rel="noopener noreferrer" class="underline" style="color: rgb(var(--color-accent));">CodeCrafters, Inc.</a>
          It is licensed under <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer" class="underline" style="color: rgb(var(--color-accent));">CC0</a> (public domain).
        </p>
        <p>
          This website is a community presentation of that data. All tutorial links point to their original sources.
        </p>
      </div>
    </article>
  </div>
</BaseLayout>
