---
import type { Tutorial } from '../data/types';
import { getMediaTypeLabel } from '../utils/helpers';

interface Props {
  tutorial: Tutorial;
  showCategory?: boolean;
}

const { tutorial, showCategory = false } = Astro.props;
const isVideo = tutorial.mediaType === 'video';
---

<article class="card group p-4">
  <a
    href={tutorial.url}
    target="_blank"
    rel="noopener noreferrer"
    class="block focus-visible:outline-none"
    aria-label={`${tutorial.title} — ${tutorial.languages.join(', ')} ${getMediaTypeLabel(tutorial.mediaType).toLowerCase()} on ${tutorial.domain}`}
  >
    <!-- Language badges + media type -->
    <div class="flex flex-wrap items-center gap-1.5 mb-2">
      {tutorial.languages.map((lang) => (
        <span class="badge badge-lang">{lang}</span>
      ))}
      {tutorial.mediaType !== 'article' && (
        <span class="badge badge-media">
          {isVideo && (
            <svg class="mr-0.5 -ml-0.5" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          )}
          {getMediaTypeLabel(tutorial.mediaType)}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3
      class="text-sm font-semibold leading-snug line-clamp-2 transition-colors sm:text-base"
      style="color: rgb(var(--color-text));"
    >
      <span class="group-hover:underline decoration-1 underline-offset-2" style="text-decoration-color: rgb(var(--color-accent) / 0.4);">
        {tutorial.title}
      </span>
    </h3>

    <!-- Meta -->
    <div class="mt-2 flex items-center gap-2 text-caption">
      {showCategory && (
        <span class="truncate" style="color: rgb(var(--color-text-secondary));">
          {tutorial.category}
        </span>
      )}
      {showCategory && (
        <span aria-hidden="true" style="color: rgb(var(--color-border));">·</span>
      )}
      <span class="truncate">{tutorial.domain}</span>
      <span
        class="ml-auto shrink-0 transition-colors"
        style="color: rgb(var(--color-text-muted));"
        aria-hidden="true"
      >↗</span>
    </div>
  </a>
</article>
