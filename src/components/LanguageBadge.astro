---
import type { Language } from '../data/types';
import { url } from '../utils/site';

interface Props {
  language: Language;
}

const { language } = Astro.props;
---

<a
  href={url(`/languages/${language.slug}`)}
  class="card group inline-flex items-center gap-1.5 px-3 py-2 transition-all"
  aria-label={`${language.name} — ${language.tutorialCount} tutorials`}
>
  <span class="text-sm font-medium" style="color: rgb(var(--color-text));">
    {language.name}
  </span>
  <span class="text-xs text-caption">
    {language.tutorialCount}
  </span>
</a>
