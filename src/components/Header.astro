---
import { SITE, url } from '../utils/site';

const navLinks = [
  { href: url('/categories'), label: 'Categories' },
  { href: url('/languages'), label: 'Languages' },
  { href: url('/about'), label: 'About' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === url('/')) return currentPath === url('/') || currentPath === url('/') + '/';
  return currentPath.startsWith(href);
}
---

<header
  class="sticky top-0 z-40 border-b"
  style="background-color: rgb(var(--color-bg) / 0.92); border-color: rgb(var(--color-border)); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <nav class="container-page" aria-label="Main navigation">
    <div class="flex h-14 items-center justify-between sm:h-16">
      <!-- Logo -->
      <a
        href={url('/')}
        class="flex items-center gap-2 text-base font-bold sm:text-lg"
        style="color: rgb(var(--color-text));"
        aria-label={`${SITE.name} — Home`}
      >
        <span
          class="flex h-7 w-7 items-center justify-center rounded-lg text-xs text-white sm:h-8 sm:w-8 sm:text-sm"
          style="background-color: rgb(var(--color-accent));"
          aria-hidden="true"
        >✦</span>
        <span class="hidden xs:inline">
          Make Your Own <span style="color: rgb(var(--color-accent));">XYZ</span>
        </span>
        <span class="xs:hidden" aria-hidden="true">MYXYZ</span>
      </a>

      <!-- Nav links — visible on all sizes, compact on mobile -->
      <div class="flex items-center gap-0.5 sm:gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-lg px-2 py-1.5 text-xs font-medium transition-colors sm:px-3 sm:py-2 sm:text-sm',
              isActive(link.href)
                ? 'font-semibold'
                : '',
            ]}
            style={isActive(link.href)
              ? 'background-color: rgb(var(--color-accent-soft)); color: rgb(var(--color-accent));'
              : 'color: rgb(var(--color-text-secondary));'
            }
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          type="button"
          class="ml-1 rounded-lg p-1.5 transition-colors sm:ml-2 sm:p-2"
          style="color: rgb(var(--color-text-muted));"
          aria-label="Toggle dark mode"
        >
          <svg class="dark:hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="hidden dark:block" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </div>
    </div>
  </nav>
</header>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }
  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
