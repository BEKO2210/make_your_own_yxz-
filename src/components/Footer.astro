---
import { SITE } from '../utils/site';
const currentYear = new Date().getFullYear();
---

<footer class="surface-soft" role="contentinfo">
  <div class="container-page py-10 sm:py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="text-base font-bold sm:text-lg" style="color: rgb(var(--color-text));">
          Make Your Own <span style="color: rgb(var(--color-accent));">XYZ</span>
        </a>
        <p class="mt-2 text-sm leading-relaxed text-body" style="max-width: 28ch;">
          Discover step-by-step tutorials for recreating your favorite technologies from scratch.
        </p>
      </div>

      <!-- Browse -->
      <div>
        <h3 class="text-sm font-semibold" style="color: rgb(var(--color-text));">Browse</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/categories" class="text-sm text-body hover:underline">All Categories</a></li>
          <li><a href="/languages" class="text-sm text-body hover:underline">By Language</a></li>
          <li><a href="/categories/database" class="text-sm text-body hover:underline">Databases</a></li>
          <li><a href="/categories/programming-language" class="text-sm text-body hover:underline">Programming Languages</a></li>
          <li><a href="/categories/game" class="text-sm text-body hover:underline">Games</a></li>
        </ul>
      </div>

      <!-- Languages -->
      <div>
        <h3 class="text-sm font-semibold" style="color: rgb(var(--color-text));">Popular Languages</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/languages/python" class="text-sm text-body hover:underline">Python</a></li>
          <li><a href="/languages/javascript" class="text-sm text-body hover:underline">JavaScript</a></li>
          <li><a href="/languages/c" class="text-sm text-body hover:underline">C</a></li>
          <li><a href="/languages/rust" class="text-sm text-body hover:underline">Rust</a></li>
          <li><a href="/languages/go" class="text-sm text-body hover:underline">Go</a></li>
        </ul>
      </div>

      <!-- About -->
      <div>
        <h3 class="text-sm font-semibold" style="color: rgb(var(--color-text));">Project</h3>
        <ul class="mt-3 space-y-2">
          <li><a href="/about" class="text-sm text-body hover:underline">About</a></li>
          <li>
            <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="text-sm text-body hover:underline">
              Source Repository
              <span class="text-caption" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t pt-6 text-xs sm:flex-row sm:items-center sm:justify-between" style="border-color: rgb(var(--color-border)); color: rgb(var(--color-text-muted));">
      <p>
        Content sourced from
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="underline hover:no-underline">
          codecrafters-io/build-your-own-x
        </a>
        under CC0 license.
      </p>
      <p>&copy; {currentYear} {SITE.name}</p>
    </div>
  </div>
</footer>
