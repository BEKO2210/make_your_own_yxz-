---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-1.5 text-sm text-slate-400 flex-wrap">
    <li>
      <a href="/" class="hover:text-brand-600 transition-colors">Home</a>
    </li>
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        <span aria-hidden="true">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-brand-600 transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-slate-600 font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
