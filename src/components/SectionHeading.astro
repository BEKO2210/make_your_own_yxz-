---
interface Props {
  title: string;
  subtitle?: string;
  href?: string;
  linkText?: string;
}

const { title, subtitle, href, linkText = 'View all' } = Astro.props;
---

<div class="mb-5 sm:mb-6 flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between sm:gap-4">
  <div>
    <h2 class="heading-2">{title}</h2>
    {subtitle && <p class="mt-1 text-sm text-body sm:text-base">{subtitle}</p>}
  </div>
  {href && (
    <a
      href={href}
      class="text-sm font-medium transition-colors shrink-0"
      style="color: rgb(var(--color-accent));"
    >
      {linkText} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
