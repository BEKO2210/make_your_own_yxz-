---
interface Props {
  placeholder?: string;
  categories?: { slug: string; name: string }[];
  languages?: { slug: string; name: string }[];
  showCategoryFilter?: boolean;
  showLanguageFilter?: boolean;
}

const {
  placeholder = 'Search tutorials...',
  categories = [],
  languages = [],
  showCategoryFilter = false,
  showLanguageFilter = false,
} = Astro.props;
---

<div class="search-filter-wrapper mb-8">
  <div class="flex flex-col sm:flex-row gap-3">
    <!-- Search input -->
    <div class="relative flex-1">
      <label for="search-input" class="sr-only">Search tutorials</label>
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </span>
      <input
        type="search"
        id="search-input"
        placeholder={placeholder}
        autocomplete="off"
        class="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm text-slate-900 placeholder:text-slate-400 focus:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors"
      />
    </div>

    <!-- Category filter -->
    {showCategoryFilter && categories.length > 0 && (
      <div class="relative">
        <label for="category-filter" class="sr-only">Filter by category</label>
        <select
          id="category-filter"
          class="appearance-none rounded-lg border border-slate-200 bg-white py-2.5 pl-3 pr-8 text-sm text-slate-700 focus:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors cursor-pointer"
        >
          <option value="">All categories</option>
          {categories.map((cat) => (
            <option value={cat.slug}>{cat.name}</option>
          ))}
        </select>
      </div>
    )}

    <!-- Language filter -->
    {showLanguageFilter && languages.length > 0 && (
      <div class="relative">
        <label for="language-filter" class="sr-only">Filter by language</label>
        <select
          id="language-filter"
          class="appearance-none rounded-lg border border-slate-200 bg-white py-2.5 pl-3 pr-8 text-sm text-slate-700 focus:border-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-100 transition-colors cursor-pointer"
        >
          <option value="">All languages</option>
          {languages.map((lang) => (
            <option value={lang.slug}>{lang.name}</option>
          ))}
        </select>
      </div>
    )}
  </div>

  <!-- Result count -->
  <p id="result-count" class="mt-3 text-sm text-slate-400 hidden" aria-live="polite"></p>
</div>

<script>
  function initSearch() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const categoryFilter = document.getElementById('category-filter') as HTMLSelectElement | null;
    const languageFilter = document.getElementById('language-filter') as HTMLSelectElement | null;
    const resultCount = document.getElementById('result-count');
    const cards = document.querySelectorAll<HTMLElement>('[data-tutorial-card]');

    if (!searchInput || cards.length === 0) return;

    function filterCards() {
      const query = searchInput!.value.toLowerCase().trim();
      const categorySlug = categoryFilter?.value || '';
      const languageSlug = languageFilter?.value || '';
      let visible = 0;

      cards.forEach((card) => {
        const title = (card.dataset.title || '').toLowerCase();
        const languages = (card.dataset.languages || '').toLowerCase();
        const category = card.dataset.category || '';
        const domain = (card.dataset.domain || '').toLowerCase();

        const matchesSearch = !query ||
          title.includes(query) ||
          languages.includes(query) ||
          domain.includes(query);

        const matchesCategory = !categorySlug || category === categorySlug;
        const matchesLanguage = !languageSlug ||
          languages.split(',').some((l: string) => l.trim() === languageSlug);

        const show = matchesSearch && matchesCategory && matchesLanguage;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });

      if (resultCount) {
        if (query || categorySlug || languageSlug) {
          resultCount.textContent = `${visible} ${visible === 1 ? 'tutorial' : 'tutorials'} found`;
          resultCount.classList.remove('hidden');
        } else {
          resultCount.classList.add('hidden');
        }
      }
    }

    searchInput.addEventListener('input', filterCards);
    categoryFilter?.addEventListener('change', filterCards);
    languageFilter?.addEventListener('change', filterCards);
  }

  // Run on initial load and on Astro page transitions
  initSearch();
  document.addEventListener('astro:after-swap', initSearch);
</script>
